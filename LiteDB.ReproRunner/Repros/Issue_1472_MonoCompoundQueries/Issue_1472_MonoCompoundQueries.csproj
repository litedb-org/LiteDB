<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseProjectReference Condition="'$(UseProjectReference)' == ''">false</UseProjectReference>
    <LiteDBPackageVersion Condition="'$(LiteDBPackageVersion)' == ''">5.0.2</LiteDBPackageVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseProjectReference)' == 'true'">
    <ProjectReference Include="../../../LiteDB/LiteDB.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseProjectReference)' != 'true'">
    <PackageReference Include="LiteDB" Version="$(LiteDBPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageDownload Include="System.Buffers" Version="[4.5.1]" />
    <PackageDownload Include="System.Memory" Version="[4.5.0]" />
    <PackageDownload Include="System.Runtime.CompilerServices.Unsafe" Version="[4.5.0]" />
    <Compile Remove="MonoProgram.cs" />
    <None Include="MonoProgram.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../LiteDB.Tests/Issues/Issue1472_CompoundQueryScenario.cs"
          Link="Issue1472_CompoundQueryScenario.cs" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../LiteDB.ReproRunner.Shared/LiteDB.ReproRunner.Shared.csproj" />
    <AssemblyMetadata Include="LiteDB.ReproRunner.UseProjectReference" Value="$(UseProjectReference)" />
    <AssemblyMetadata Include="LiteDB.ReproRunner.LiteDBPackageVersion" Value="$(LiteDBPackageVersion)" />
  </ItemGroup>
  <Target Name="StageMonoInputs"
          AfterTargets="Build"
>
    <PropertyGroup>
      <_MonoInputDirectory>$([System.IO.Path]::Combine('$(OutputPath)', 'mono-input'))</_MonoInputDirectory>
      <_MonoSourceOutput>$([System.IO.Path]::Combine('$(_MonoInputDirectory)', 'source-build'))</_MonoSourceOutput>
    </PropertyGroup>

    <MSBuild Projects="..\..\..\LiteDB\LiteDB.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0;TestingEnabled=false;GitVersionEnabled=false;OutputPath=$(_MonoSourceOutput)/;AppendTargetFrameworkToOutputPath=false"
             Condition="'$(UseProjectReference)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_MonoSourceLiteDb" />
    </MSBuild>

    <ItemGroup>
      <_MonoLiteDb Include="@(_MonoSourceLiteDb)" Condition="'$(UseProjectReference)' == 'true'" />
      <_MonoLiteDb Include="$(NuGetPackageRoot)/litedb/$(LiteDBPackageVersion)/lib/netstandard2.0/LiteDB.dll"
                   Condition="'$(UseProjectReference)' != 'true'" />
      <_MonoDependency Include="$(NuGetPackageRoot)/system.buffers/4.5.1/lib/netstandard2.0/System.Buffers.dll" />
      <_MonoDependency Include="$(NuGetPackageRoot)/system.memory/4.5.0/lib/netstandard2.0/System.Memory.dll" />
      <_MonoDependency Include="$(NuGetPackageRoot)/system.runtime.compilerservices.unsafe/4.5.0/lib/netstandard2.0/System.Runtime.CompilerServices.Unsafe.dll" />
    </ItemGroup>

    <MakeDir Directories="$(_MonoInputDirectory)" />
    <Copy SourceFiles="@(_MonoLiteDb);@(_MonoDependency)" DestinationFolder="$(_MonoInputDirectory)" />
  </Target>
</Project>
