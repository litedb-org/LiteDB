<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <WorkerTargetFramework Condition="'$(WorkerTargetFramework)' == '' and '$(OS)' == 'Windows_NT'">net48</WorkerTargetFramework>
    <WorkerTargetFramework Condition="'$(WorkerTargetFramework)' == ''">net8.0</WorkerTargetFramework>
    <TargetFramework>$(WorkerTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseProjectReference Condition="'$(UseProjectReference)' == ''">false</UseProjectReference>
    <LiteDBPackageVersion Condition="'$(LiteDBPackageVersion)' == ''">5.0.10</LiteDBPackageVersion>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net48'">x86</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseProjectReference)' == 'true'">
    <ProjectReference Include="../../../../LiteDB/LiteDB.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseProjectReference)' != 'true'">
    <PackageReference Include="LiteDB" Version="$(LiteDBPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <Compile Include="../../../../LiteDB.Tests/Issues/Issue2059_Tests.cs" Link="Regression.cs" />
    <Compile Include="../../../../LiteDB.Tests/Utils/TempFile.cs" Link="TempFile.cs" />
    <AssemblyMetadata Include="LiteDB.ReproRunner.UseProjectReference" Value="$(UseProjectReference)" />
  </ItemGroup>
</Project>
