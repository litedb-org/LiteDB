<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The linked LiteDB.Tests/Utils/ArtifactFixtures.cs is not nullable-annotated. -->
    <Nullable>disable</Nullable>
    <UseProjectReference Condition="'$(UseProjectReference)' == ''">false</UseProjectReference>
    <!-- The known-bad state (see .github/safety/regression-proofs.json). -->
    <LiteDBPackageVersion Condition="'$(LiteDBPackageVersion)' == ''">6.0.0-prerelease.319</LiteDBPackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseProjectReference)' == 'true'">
    <ProjectReference Include="..\..\..\LiteDB\LiteDB.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReference)' != 'true'">
    <PackageReference Include="LiteDB" Version="$(LiteDBPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LiteDB.ReproRunner.Shared\LiteDB.ReproRunner.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DropIndex_5_0_21.zip (written by the LiteDB 5.0.21 package) lives in LiteDB-Artifacts; the repro
         resolves it exactly as the permanent guard does, through the test suite's pinned manifest. -->
    <Compile Include="..\..\..\LiteDB.Tests\Utils\ArtifactFixtures.cs" Link="ArtifactFixtures.cs" />
    <EmbeddedResource Include="..\..\..\LiteDB.Tests\Resources\artifacts.json" LogicalName="LiteDB.Tests.Resources.artifacts.json" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="LiteDB.ReproRunner.UseProjectReference" Value="$(UseProjectReference)" />
    <AssemblyMetadata Include="LiteDB.ReproRunner.LiteDBPackageVersion" Value="$(LiteDBPackageVersion)" />
  </ItemGroup>
</Project>
