+#if (DEBUG || TESTING) && NET8_0_OR_GREATER
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Threading;
+
+namespace LiteDB.Client.Shared
+{
+    // Diagnostic graft only. Numeric handles and strings retain no native/object lease.
+    internal static class NativeLockLifetimeDiagnostic
+    {
+        internal sealed class Entry
+        {
+            public long Id, Handle, OpenedAt, ClosedAt;
+            public int Thread;
+            public string Path;
+            public bool IsClosed;
+        }
+        private static readonly object Gate = new object();
+        private static readonly Dictionary<long, Entry> Entries = new Dictionary<long, Entry>();
+        private static long _next;
+        internal static long Opened(string path, long handle)
+        {
+            var id = Interlocked.Increment(ref _next);
+            lock (Gate) Entries.Add(id, new Entry { Id = id, Handle = handle,
+                Path = path, OpenedAt = Stopwatch.GetTimestamp(), Thread = Environment.CurrentManagedThreadId });
+            return id;
+        }
+        internal static void Closed(long id, bool closed)
+        {
+            lock (Gate)
+                if (Entries.TryGetValue(id, out var entry) && entry.ClosedAt == 0)
+                { entry.ClosedAt = Stopwatch.GetTimestamp(); entry.IsClosed = closed; }
+        }
+        internal static Entry[] Snapshot(string filename)
+        {
+            var suffix = System.IO.Path.GetFileName(System.IO.Path.GetDirectoryName(filename)) + "/" +
+                System.IO.Path.GetFileName(filename);
+            lock (Gate) return Entries.Values.Where(e => e.Path.Replace('\\', '/').EndsWith(suffix,
+                StringComparison.OrdinalIgnoreCase)).Select(e => new Entry { Id = e.Id, Handle = e.Handle,
+                    OpenedAt = e.OpenedAt, ClosedAt = e.ClosedAt, Thread = e.Thread,
+                    Path = e.Path, IsClosed = e.IsClosed }).ToArray();
+        }
+    }
+}
+#endif
