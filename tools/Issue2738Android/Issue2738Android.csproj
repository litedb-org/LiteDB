<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>org.litedb.issue2738</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <UseProjectReference Condition="'$(UseProjectReference)' == ''">false</UseProjectReference>
    <LiteDBPackageVersion Condition="'$(LiteDBPackageVersion)' == ''">5.0.21</LiteDBPackageVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseProjectReference)' == 'true'">
    <ProjectReference Include="../../LiteDB/LiteDB.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseProjectReference)' != 'true'">
    <PackageReference Include="LiteDB" Version="$(LiteDBPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <Compile Include="../../LiteDB.Tests/Issues/Issue2738_NativeControlTests.cs" Link="Regression.cs" />
    <AssemblyMetadata Include="UseProjectReference" Value="$(UseProjectReference)" />
    <AssemblyMetadata Include="LiteDBPackageVersion" Value="$(LiteDBPackageVersion)" />
  </ItemGroup>
</Project>
