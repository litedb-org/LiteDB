<Project Sdk="Microsoft.NET.Sdk">
  <!-- Candidate-only consumer of the handle API. The script builds it with
       TreatWarningsAsErrors=true: the replacement API must emit no warning. -->
  <PropertyGroup>
    <FixtureFramework Condition="'$(FixtureFramework)' == ''">net10.0</FixtureFramework>
    <TargetFramework>$(FixtureFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="LiteDB">
      <HintPath>$(LibraryPath)</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireLibraryPath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(LibraryPath)' == '' or !Exists('$(LibraryPath)')" Text="Set LibraryPath to an existing LiteDB.dll." />
  </Target>
</Project>
