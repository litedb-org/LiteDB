<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LiteDBAssembly Condition="'$(LiteDBAssembly)' == ''">../../LiteDB/bin/Release/net8.0/LiteDB.dll</LiteDBAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LiteDB"><HintPath>$(LiteDBAssembly)</HintPath></Reference>
  </ItemGroup>
</Project>
