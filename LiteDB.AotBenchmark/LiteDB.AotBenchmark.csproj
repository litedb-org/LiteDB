<Project Sdk="Microsoft.NET.Sdk">
  <!--
  Measures the same workloads as a JIT application and as a Native AOT binary. Published as Native AOT, every
  BsonExpression runs through the System.Linq.Expressions interpreter instead of compiled code, so the question
  this answers is what that costs. See docs/AOT.md for how to run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <BenchmarkTargetFramework Condition="'$(BenchmarkTargetFramework)' == ''">net8.0</BenchmarkTargetFramework>
    <TargetFramework>$(BenchmarkTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteDB\LiteDB.csproj" />
    <ProjectReference Include="..\LiteDB.SourceGenerator\LiteDB.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
